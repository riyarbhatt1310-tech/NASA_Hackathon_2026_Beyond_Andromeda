# ==============================================================================
# TerraTwin Repository .gitignore
# ==============================================================================

# Python Bytecode, Caches & Coverage
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
.env
.env.local
.env.*.local
*.env
!.env.example
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
.eslintcache

# Sensitive Credentials & Cloud Keys
credentials.json
*service_account*.json
*gee_key*.json
*.pem
*.key
*.p12

# IDEs, Editors & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Large Raw Planetary Raster Datasets (> 100 MB GitHub limit)
data/raw/
*.img
*.IMG
*.tif
*.tiff
*.nc
*.nc4
*.grd
*.zip
*.tar.gz
*.tgz

# Scratch & Temporary Logs
scratch/
*.log
*.tmp
