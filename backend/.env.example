# TerraTwin Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Dataset Overrides (Optional - defaults to data/raw/)
# TERRATWIN_MOON_RASTER=data/raw/moon/LDEM_16_FLOAT.IMG
# TERRATWIN_MOON_LABEL=data/raw/moon/LDEM_16_FLOAT.LBL
# TERRATWIN_MARS_RASTER=data/raw/mars/megt90n000eb.img
# TERRATWIN_MARS_METADATA=data/raw/mars/megt90n000eb.xml
# TERRATWIN_EARTH_DEM=data/raw/earth/dem/ETOPO_2022_v1_60s_N90W180_surface.tif

# Scientific Configuration
DEFAULT_MIN_COVERAGE=0.60
DEFAULT_TILE_SIZE_KM=25.0
